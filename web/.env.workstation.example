# This profile is for the workstation operator. Keep secrets out of source control.
V5_HOST=127.0.0.1
V5_PORT=8765
V5_PREVIEW_ONLY=true
V5_REGISTRATION_ENABLED=false
V5_ALLOW_EXTERNAL_AI=false
V5_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
V5_LOCAL_LLM_MODEL=
# Optional: absolute data path; exported environment takes precedence.
# V5_DATA_DIR=D:/GD-data
# V5_SECRET_KEY may remain unset: a per-installation secret is created locally.
